# Example secrets configuration for GLPI SSO
# Copy this file to secrets.yaml and update with your actual values
# DO NOT commit secrets.yaml to version control

# MySQL Secrets
mysql:
  auth:
    rootPassword: "your-secure-root-password"
    password: "your-secure-glpi-password"

# Keycloak Secrets
keycloak:
  auth:
    adminPassword: "your-secure-admin-password"

# OAuth2-Proxy Secrets
oauth2-proxy:
  config:
    clientSecret: "your-secure-client-secret"
    cookieSecret: "your-secure-cookie-secret"

# GLPI Environment Variables (if needed)
glpi:
  env:
    # Add any additional GLPI environment variables here
    # Example:
    # GLPI_CRON_FREQUENCY: "300"
    # GLPI_MAIL_RETRIES: "3"
